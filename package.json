{
  "name": "astro-remix",
  "version": "0.1.0",
  "description": "Use Remix 3 components within Astro",
  "type": "module",
  "author": "Angel A. Núñez",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mailok/astro-remix.git"
  },
  "bugs": "https://github.com/mailok/astro-remix/issues",
  "homepage": "https://github.com/mailok/astro-remix#readme",
  "keywords": [
    "astro-integration",
    "astro-component",
    "withastro",
    "renderer",
    "remix"
  ],
  "engines": {
    "node": ">=24.3.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./component": {
      "types": "./dist/component.d.ts",
      "default": "./dist/component.js"
    },
    "./container-renderer": {
      "types": "./dist/container-renderer.d.ts",
      "default": "./dist/container-renderer.js"
    },
    "./client.js": "./dist/client.js",
    "./server.js": "./dist/server.js",
    "./package.json": "./package.json",
    "./astro-types": {
      "types": "./dist/astro-types.d.ts",
      "default": "./dist/astro-types.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test --test-concurrency=1 test/units/*.test.mjs test/build.test.mjs test/types.test.mjs",
    "test:browser": "npm run build && node --test --test-concurrency=1 test/browser.test.mjs test/mixed.browser.test.mjs test/ssr.test.mjs",
    "check": "npm run typecheck && npm test && npm run test:browser",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.mjs\" \"*.json\" \"docs/*.md\" README.md",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.mjs\" \"*.json\" \"docs/*.md\" README.md",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "dependencies": {
    "magic-string": "^1.4.5",
    "ultrahtml": "^1.7.0",
    "vite": "^8.3.5",
    "@jridgewell/remapping": "^2.3.5"
  },
  "peerDependencies": {
    "astro": "^7.4.4",
    "remix": "^3.1.0"
  },
  "devDependencies": {
    "astro": "7.4.4",
    "remix": "3.1.0",
    "typescript": "~6.0.3",
    "@types/node": "^24.0.0",
    "playwright": "^1.60.0",
    "@astrojs/check": "^0.9.12",
    "@astrojs/react": "7.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "@astrojs/preact": "6.1.1",
    "preact": "^11.0.1",
    "@astrojs/solid-js": "7.1.2",
    "solid-js": "^1.9.17",
    "@astrojs/svelte": "9.1.2",
    "svelte": "^5.57.2",
    "@astrojs/vue": "7.1.2",
    "vue": "^3.5.43",
    "@astrojs/mdx": "8.1.2",
    "@astrojs/node": "11.1.9",
    "prettier": "3.9.10"
  }
}
