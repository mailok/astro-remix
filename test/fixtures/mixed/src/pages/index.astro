---
import { Counter as Remix } from '../components/remix/Counter';
import { Shell as RemixShell } from '../components/remix/Shell';
import { Counter as React, Shell as ReactShell } from '../components/react/Counter';
import { Counter as Preact } from '../components/preact/Counter';
import { Counter as Solid } from '../components/solid/Counter';
import Svelte from '../components/Counter.svelte';
import Vue from '../components/Counter.vue';
---
<html lang="en"><head><meta charset="utf-8" /><link rel="icon" href="data:," /><title>All renderers</title></head><body>
  <RemixShell client:load>
    <Remix client:load />
    <React client:load />
    <Preact client:load />
    <Solid client:load />
    <Svelte client:load />
    <Vue client:load />
  </RemixShell>
  <ReactShell client:load><Remix client:load name="remix-in-react" /></ReactShell>
</body></html>
